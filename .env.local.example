# Copie este arquivo para .env.local e preencha com os dados do SEU projeto Supabase.
# Onde encontrar: Supabase Dashboard > seu projeto > Project Settings > API.

# Project URL e chave "anon public" — usadas pelo app (browser e servidor).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" — NUNCA exponha no cliente. Usada apenas pelas
# Server Actions do painel /admin (src/lib/supabase/admin.ts) para criar,
# editar, bloquear e excluir usuários.
SUPABASE_SERVICE_ROLE_KEY=
